<% if current_user %>
  <main class='content'>
    <section class='top-nav'>
      <%=link_to root_path do %>
        <i class="fa-solid fa-arrow-left"></i>
      <% end %>
      <h3>Your Debts</h3>
    </section>

    <section class='flashes'>
      <% if flash[:alert] %>
        <div class="alert alert-danger">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice].present? %>
        <div class='flash-msg'>
          <%=flash[:notice]%>
        </div>
      <% end %>
    </section>

    <section class='debt-section'>
      <% if @creditors.where(user_id: current_user.id).any? %>
        <article>
          <% displayed_creditor_ids = [] %>
          <% @creditors.where(user_id: current_user.id).each do |creditor| %>
            <% unless displayed_creditor_ids.include?(creditor.id) %>
              <% total_amount_owed = Debt.total_amount(creditor.id)%>
              <% debt = creditor.debts.first %>
              <div class='debt-box' data-controller="debts">
                <div class='debt-detail'>
                  <p class='amt'><%= link_to (creditor.currency == nil) ? '$' : creditor.currency, edit_creditor_path(creditor) %><%= total_amount_owed %></p>
                  <div class='debtor-info'>
                    <p class='debtor'>to: <%= creditor.creditor %></p>
                    <p>Due: <%= debt&.due_date %></p>
                  </div>
                </div>
                <% if total_amount_owed == 0%>
                  <%= form_with(model: creditor, url: creditor_path(creditor),
                    method: :delete, data: { action: "click->debts#delete" }) do |form| %>
                    <%= form.button '', class: 'btn', type: 'submit' do %>
                      <i class="fa-regular fa-trash-can"></i>
                    <%end%>
                  <% end %>
                <%end%>
                <%= link_to debts_path(id: creditor), class: 'edit-link' do %>
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <% end %>
              </div>
              <% displayed_creditor_ids << creditor.id %>
            <% end %>
          <% end %>
        </article>
      <% else %>
        <p class='no-debt'>You did not have any Creditor, use the button below to add new debts</p>
      <% end %>
    </section>
  </main>

  <footer class='footer'>
    <%=link_to new_creditor_path do %>
      <button>New Debt</button>
    <%end%>
  </footer>
<% else %>
  <p class='page-denied'>You need to <%= link_to 'sign in', new_user_session_path %> to access this page</p>
<% end %>
